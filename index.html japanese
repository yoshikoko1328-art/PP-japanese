<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>日本神話・妖怪 古地図絵図</title>
<style>
/* ===== 色の設定（ここを変えると全体の色味を編集できます）===== */
:root{
  --paper:#f3e8c8;        /* ベージュ（紙） */
  --paper-light:#fbf6e4;  /* 白に近い生成り */
  --paper-dark:#dcc999;   /* 濃いベージュ */
  --ink:#3a2a1a;          /* 墨 */
  --ink-soft:#6b5236;
  --gold:#e8b923;         /* 黄色（神様） */
  --gold-deep:#b98a0f;
  --white:#fffdf5;        /* 白（妖怪） */
  --seal:#a8321f;         /* 落款の朱（タイトルの印のみ） */
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--paper-dark);color:var(--ink);
  font-family:"Yu Mincho","Hiragino Mincho ProN","Noto Serif JP","Sawarabi Mincho",serif;
  -webkit-tap-highlight-color:transparent}

/* ===== 地図ビューポート ===== */
#viewport{position:fixed;inset:0;overflow:hidden;cursor:grab;touch-action:none;
  background:
   radial-gradient(ellipse at center,transparent 55%,rgba(120,80,30,.35) 100%),
   var(--paper);}
#viewport.dragging{cursor:grabbing}
#world{position:absolute;left:0;top:0;width:1200px;height:1000px;transform-origin:0 0;will-change:transform}
#mapsvg{position:absolute;inset:0;width:100%;height:100%;display:block}

/* ===== ピン ===== */
.pin{position:absolute;width:0;height:0}
.pin .dot{position:absolute;left:-14px;top:-14px;width:28px;height:28px;border-radius:50%;
  border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;cursor:pointer;
  box-shadow:1px 2px 3px rgba(58,42,26,.4);
  transform:scale(var(--inv,1));transition:box-shadow .15s}
.pin.yokai .dot{background:var(--white);color:var(--ink)}
.pin.kami .dot{background:var(--gold);color:var(--ink)}
.pin .dot:hover,.pin .dot:focus-visible{box-shadow:0 0 0 3px rgba(232,185,35,.7),1px 2px 3px rgba(58,42,26,.4);outline:none}
.pin .tag{position:absolute;left:0;top:0;transform:translate(-50%,0) scale(var(--inv,1));
  transform-origin:50% 0;margin-top:calc(16px * var(--inv,1));
  white-space:nowrap;font-size:11px;padding:1px 5px;background:rgba(251,246,228,.92);
  border:1px solid var(--ink-soft);border-radius:2px;pointer-events:none;opacity:0;transition:opacity .15s}
.show-labels .pin .tag{opacity:1}
.pin.hidden{display:none}

/* ===== 地名ラベル ===== */
.region-label{position:absolute;transform:translate(-50%,-50%) scale(var(--inv,1));
  font-size:26px;letter-spacing:.35em;color:var(--ink-soft);opacity:.75;pointer-events:none;
  text-shadow:0 0 6px var(--paper-light),0 0 6px var(--paper-light);white-space:nowrap}

/* ===== UI ===== */
.title{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:12px;z-index:10;
  background:rgba(251,246,228,.94);border:1px solid var(--ink);outline:1px solid var(--ink);outline-offset:3px;
  padding:8px 16px 8px 14px;display:flex;align-items:center;gap:10px;max-width:calc(100vw - 100px)}
.title h1{margin:0;font-size:1.05rem;letter-spacing:.18em;font-weight:700}
.title .seal{width:26px;height:26px;background:var(--seal);color:#fff;font-size:13px;
  display:flex;align-items:center;justify-content:center;border-radius:2px;flex:none}

.ctrl{position:fixed;right:12px;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:10;display:flex;flex-direction:column;gap:8px}
.ctrl button,.filters button,.regions button,.refbtn{font-family:inherit;color:var(--ink);cursor:pointer;
  background:rgba(251,246,228,.95);border:1px solid var(--ink)}
.ctrl button{width:42px;height:42px;font-size:20px;border-radius:3px}
.ctrl button:active,.filters button:active,.regions button:active{background:var(--gold)}

.filters{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));right:12px;z-index:10;display:flex;flex-direction:column;gap:6px}
.filters button{padding:6px 10px;font-size:12px;border-radius:3px}
.filters button[aria-pressed="true"]{background:var(--gold);font-weight:700}

.regions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:6px;overflow-x:auto;
  padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));
  background:linear-gradient(to top,rgba(243,232,200,.97) 70%,rgba(243,232,200,0));scrollbar-width:none}
.regions::-webkit-scrollbar{display:none}
.regions button{flex:none;padding:8px 14px;font-size:14px;border-radius:3px;letter-spacing:.1em}

.legend{position:fixed;left:12px;bottom:calc(64px + env(safe-area-inset-bottom,0px));z-index:10;
  background:rgba(251,246,228,.94);border:1px solid var(--ink-soft);padding:6px 10px;font-size:12px;line-height:1.7}
.legend i{display:inline-block;width:12px;height:12px;border-radius:50%;border:1.5px solid var(--ink);vertical-align:-2px;margin-right:4px}
.legend .refbtn{display:block;margin-top:4px;padding:2px 6px;font-size:12px;border-radius:2px;width:100%}

/* ===== 詳細シート ===== */
#sheetBack{position:fixed;inset:0;z-index:30;background:rgba(58,42,26,.45);display:none;
  align-items:flex-end;justify-content:center}
#sheetBack.open{display:flex}
.sheet{width:100%;max-width:640px;max-height:82vh;overflow-y:auto;
  background:var(--paper-light);border:2px solid var(--ink);outline:1px solid var(--ink);outline-offset:-7px;
  padding:26px 24px calc(28px + env(safe-area-inset-bottom,0px));position:relative;
  animation:up .22s ease-out}
@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){.sheet{animation:none}}
@media (min-width:700px){#sheetBack{align-items:center}.sheet{border-radius:2px}}
.sheet .x{position:absolute;top:8px;right:10px;width:40px;height:40px;font-size:26px;background:none;border:0;color:var(--ink);cursor:pointer}
.sheet h2{margin:0 0 8px;font-size:1.6rem;letter-spacing:.06em;padding-right:36px}
.badge{display:inline-block;font-size:12px;padding:1px 10px;border:1px solid var(--ink);margin-right:8px;border-radius:2px}
.badge.kami{background:var(--gold)}
.badge.yokai{background:var(--white)}
.sheet dl{margin:0}
.sheet dt{font-weight:700;margin:14px 0 4px;padding-left:8px;border-left:4px solid var(--gold-deep)}
.sheet dd{margin:0;line-height:1.85;font-size:1rem;padding-left:12px}
.illust{margin:16px 0 0;padding:10px;background:var(--paper);border:1px solid var(--ink-soft);text-align:center}
.illust img{max-width:100%;max-height:220px;object-fit:contain}
.illust figcaption{font-size:.8rem;margin-top:6px;color:var(--ink-soft);word-break:break-all}
.illust a,.sheet a{color:#6a4a10}
.refs li{margin-bottom:8px;line-height:1.7}
.hint{position:fixed;left:50%;top:calc(70px + env(safe-area-inset-top,0px));transform:translateX(-50%);z-index:9;
  background:rgba(58,42,26,.85);color:var(--paper-light);font-size:12px;padding:5px 14px;border-radius:14px;
  pointer-events:none;transition:opacity .6s;white-space:nowrap}
</style>
</head>
