<script>
/* =====================================================================
   データ編集エリア
   ・REGIONS … 各地方の中心座標(x,y)と広がり(r)。地図は 1200×1000 の座標
   ・DATA    … [種類, 名前, 場所, 内容, 誕生経緯, (任意)画像URL, 出典名, 出典URL]
   イラストを追加する場合は、配列の後ろに 画像URL・出典名・出典URL を足してください。
   ===================================================================== */
const REGIONS = {
  "北海道":{x:966,y:172,r:58},
  "東北":  {x:880,y:385,r:66},
  "関東":  {x:896,y:474,r:46},
  "中部":  {x:760,y:480,r:70},
  "近畿":  {x:622,y:552,r:48},
  "中国":  {x:492,y:566,r:58},
  "四国":  {x:556,y:648,r:44},
  "九州":  {x:340,y:672,r:56},
  "沖縄":  {x:236,y:870,r:66}
};

const DATA = {
"北海道":[
["妖怪","アコロカムイ","噴火湾（内浦湾）周辺","巨大なタコのような巨大海洋生物。船を丸呑みにする巨大さを持ち、赤く巨大な体が海面を覆い尽くすとされる。","アイヌ民話において、海の巨大生物や奇怪な現象への畏怖が具現化したもの。"],
["妖怪","アイヌラックル（妖怪としての伝承側面）","北海道全域","基本的には英雄神だが、地域によっては悪霊や化け物（ウェンカムイ）退治の物語において、異形の敵として語り継がれる場合がある。","自然の脅威や不可解な災害を英雄と対峙する存在として例えたことから生じた。"],
["妖怪","パヨカカムイ","北海道各地域","人々に流行病や悪病をもたらす病魔・魔物。黒い影のような姿や醜い老婆の姿で現れるとされる。","集団感染などの病気の恐怖を可視化し、予防や禁忌を守らせるために語られた。"],
["妖怪","ケナシコログル","北海道の森林地域","草むらや茂みに潜むとされる怪異。人を迷わせたり、不気味な音を立てて驚かせたりする。","未開拓の深い森に対する恐怖や道迷いの現象から生まれた。"],
["妖怪","イワオロペネレプ","北海道の山岳地帯","山に棲む巨大な魔鳥。鋭いクチバシと爪を持ち、人や家畜を襲うとされる。","険しい山々の威容や大型猛禽類への畏怖から派生した伝説。"],
["神様","カムイチカプ（シマフクロウの神）","北海道全域","コタン（集落）を護る村護りの神。夜間に音もなく飛び、人々に異変を知らせる。","アイヌの人々がシマフクロウの夜行性や観察力の高さに感謝し、保護神として崇めた。"],
["神様","アペフチカムイ（火の神）","北海道各地域の囲炉裏","囲炉裏の火に宿る女性の神。神々への祈りを届ける仲介者であり、家庭の安全を見守る。","厳しい寒さの北海道において、暖や調理に不可欠な「火」を敬う信仰から誕生。"],
["神様","キムンカムイ（ヒグマの神）","北海道の山林","山を支配する高位の神。肉と皮（毛皮）を人々に与えるために下界へ現れるとされる。","山の恵みと命の尊厳に対する感謝と祈りから生まれた。"],
["神様","レプンカムイ（シャチの神）","北海道沿岸部","海の沖合を司る神。クジラなどを浜に追い込み、人々に恵みをもたらす福の神。","シャチが集団で獲物を追う習性や、海洋の恵みへの感謝から信仰された。"],
["神様","ハシナウカムイ（狩猟の神）","北海道の山林","山での狩猟の成否を司る女神。弓矢や獲物の授与を司る。","安定した食料確保を祈願する狩猟採集生活の中から生まれた。"]
],
"東北":[
["妖怪","座敷わらし","岩手県を中心とする東北地方","家の座敷に住み着く子供の姿をした妖怪。居着いた家は繁栄し、去ると衰退すると言われる。","家の盛衰や、過去の貧困による乳幼児の早世に対する切ない思いが背景にあるとされる。"],
["妖怪","なまはげ","秋田県男鹿市","鬼の面をかぶり、怠け者を戒めたり無病息災を祈ったりして家々を訪れる怪異・来訪神的な妖怪。","冬の厳しい気候のなか、年の節目に規律を守らせるための風習から生じた。"],
["妖怪","遠野の天狗","岩手県遠野市","山中に棲み、空中を飛び回り、不審な音を立てたり人をさらったりする山伏姿の怪異。","修験道の修験者の姿や、深山における神隠し現象への恐怖から生まれた。"],
["妖怪","雪女","青森県・秋田県など","吹雪の夜に現れる白い肌の美しい女性の妖怪。吐息で人を凍りつかせる。","極寒の雪国における遭難現象や吹雪の恐ろしさが人物化された。"],
["妖怪","黒塚の鬼婆（安達ヶ原の鬼婆）","福島県二本松市（安達ヶ原）","旅人を宿に泊め、寝ている隙に取って食うとされる恐ろしい老女の妖怪。","荒涼とした原野への畏怖や、旅の危険性を伝える教訓として伝承された。"],
