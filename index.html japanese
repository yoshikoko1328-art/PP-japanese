["妖怪","マジムン","沖縄県全域","人間を驚かせたり病気にさせたりする悪霊や妖怪の総称。股をくぐられると死ぬとされる。","原因不明の病気や災難、死者への恐怖から生じた概念。"],
["妖怪","片足ピンザ（片足のヒージャー）","宮古島など","夜道に現れる片足しかないヤギの妖怪。遭うと病気になったり悪いことが起きたりする。","夜間の薄暗い道での見誤りや、身近な家畜への怪異的妄想から。"],
["妖怪","ヒタチ","沖縄本島など","夕暮れ時に現れ、子供をさらっていく未確認の怪異。","夕暮れ時の子供の迷子予防や誘拐防止の警鐘から生じた。"],
["神様","アマミキヨ（阿摩美久）","沖縄本島（久高島・斎場御嶽など）","琉球開闢（かいびゃく）の創世女神。琉球列島と人間を造ったとされる。","琉球王国の国家神話として、島々の形成と王権の正当性を説明するために誕生。"],
["神様","ミルク神（弥勒神）","八重山諸島など","ニライカナイから豊穣と幸福をもたらす黄色い面の福神。","仏教の弥勒菩薩信仰が琉球のニライカナイ信仰と融合して定着した。"],
["神様","キンマモン","沖縄本島（王権神話）","琉球王国を守護し、祝女（ノロ）に宣託を与える至高の国家神。","琉球王国のノロ制度（神女組織）の頂点として国家統治のために祀られた。"],
["神様","火の神（ヒヌカン）","各家庭の台所","台所を守り、家庭の出来事を天の神に報告する最も身近な女神。","家庭生活の根幹である「火」と「食」への感謝から生まれた。"],
["神様","ニライカナイの神々","東の海の彼方（異界）","海の向こうから生命や五穀の種子、幸福をもたらす来訪神。","海洋国家である沖縄の人々が、豊かな海と生命の源泉に寄せた信仰から誕生。"]
]
};

/* 参考資料（画面左下の「参考資料」ボタンに表示。追加・編集できます） */
const REFERENCES = [
  "神話・妖怪の名称、場所、内容、誕生経緯：提供資料「日本神話伝説」（北海道〜沖縄の地方別一覧）",
  "地図：資料の日本地図画像を取得できなかったため、日本列島の形を参考に、手描き風のSVGで作図したデザイン地図です（実際の地形・縮尺とは異なります）",
  "イラスト：現在は未掲載です。掲載する場合は、DATAの各項目の後ろに「画像URL・出典名・出典URL」を追加すると、詳細画面に出典つきで表示されます（Wikimedia Commonsの鳥山石燕『画図百鬼夜行』など、利用条件を確認できるものを推奨）"
];

/* ===================== ここから下は動作コード ===================== */
const W=1200,H=1000;
const vp=document.getElementById('viewport');
const world=document.getElementById('world');
const pinsEl=document.getElementById('pins');
const labelsEl=document.getElementById('labels');
let scale=1, tx=0, ty=0;
const MIN=0.4, MAX=4;
let labelsOn=false, moved=false;

/* ピン配置：妖怪は地方の中心の左寄り、神様は右寄りに、円弧状に並べる */
const items=[];
Object.entries(DATA).forEach(([region,list])=>{
  const c=REGIONS[region];
  ["妖怪","神様"].forEach((cat,side)=>{
    const arr=list.filter(d=>d[0]===cat);
    arr.forEach((d,i)=>{
      const n=arr.length;
      const a=(-70+140*(i/(n-1)))*Math.PI/180;      // 縦方向の円弧
      const dir=side===0?-1:1;
      const rad=c.r*(i%2?0.55:0.8);
      const px=c.x+dir*(c.r*0.42+Math.cos(a)*rad*0.6);
      const py=c.y+Math.sin(a)*c.r*0.95;
      items.push({region,cat,name:d[1],loc:d[2],content:d[3],origin:d[4],image:d[5],srcName:d[6],srcUrl:d[7],x:px,y:py});
    });
  });
});

items.forEach(it=>{
  const p=document.createElement('div');
  p.className='pin '+(it.cat==="神様"?'kami':'yokai');
  p.style.left=it.x+'px'; p.style.top=it.y+'px';
  p.dataset.cat=it.cat==="神様"?'kami':'yokai';
  const dot=document.createElement('div');
  dot.className='dot'; dot.tabIndex=0; dot.setAttribute('role','button');
  dot.setAttribute('aria-label',it.name);
  dot.textContent=it.cat==="神様"?'神':'妖';
  const tag=document.createElement('div');
  tag.className='tag'; tag.textContent=it.name.replace(/[（(].*$/,'');
  p.append(dot,tag);
  dot.addEventListener('click',()=>{ if(!moved) openSheet(it); });
  dot.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){e.preventDefault();openSheet(it);} });
  pinsEl.appendChild(p);
});

Object.entries(REGIONS).forEach(([name,c])=>{
  const l=document.createElement('div');
  l.className='region-label'; l.textContent=name;
  l.style.left=c.x+'px'; l.style.top=(c.y-c.r-24)+'px';
  labelsEl.appendChild(l);
});

/* パン＆ズーム */
function apply(){
  world.style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;
  world.style.setProperty('--inv',(1/Math.max(scale,0.75)).toFixed(3));
  document.body.classList.toggle('show-labels', labelsOn || scale>=1.8);
}
function clamp(){
  const vw=vp.clientWidth, vh=vp.clientHeight, m=120;
  tx=Math.min(vw-m, Math.max(m-W*scale, tx));
  ty=Math.min(vh-m, Math.max(m-H*scale, ty));
}
function zoomAt(cx,cy,ns){
  ns=Math.min(MAX,Math.max(MIN,ns));
  const k=ns/scale;
  tx=cx-(cx-tx)*k; ty=cy-(cy-ty)*k; scale=ns; clamp(); apply();
}
function fit(){
  const vw=vp.clientWidth, vh=vp.clientHeight;
  scale=Math.max(MIN,Math.min(vw/W, vh/H)*1.02);
  tx=(vw-W*scale)/2; ty=(vh-H*scale)/2; clamp(); apply();
}
function flyTo(x,y,s){
  const vw=vp.clientWidth, vh=vp.clientHeight;
  world.style.transition='transform .5s cubic-bezier(.3,.7,.2,1)';
  scale=s; tx=vw/2-x*s; ty=vh*0.42-y*s; clamp(); apply();
  setTimeout(()=>world.style.transition='',520);
}

const pointers=new Map(); let lastDist=0, startPt=null;
vp.addEventListener('pointerdown',e=>{
  vp.setPointerCapture?.(e.pointerId);
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size===1){ moved=false; startPt={x:e.clientX,y:e.clientY}; }
  if(pointers.size===2){ const [a,b]=[...pointers.values()]; lastDist=Math.hypot(a.x-b.x,a.y-b.y); moved=true; }
});
vp.addEventListener('pointermove',e=>{
  if(!pointers.has(e.pointerId)) return;
  const prev=pointers.get(e.pointerId);
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size===1){
    if(!moved && Math.hypot(e.clientX-startPt.x,e.clientY-startPt.y)>6){ moved=true; vp.classList.add('dragging'); }
    if(moved){ tx+=e.clientX-prev.x; ty+=e.clientY-prev.y; clamp(); apply(); }
  } else if(pointers.size===2){
    const [a,b]=[...pointers.values()];
    const d=Math.hypot(a.x-b.x,a.y-b.y);
    if(lastDist) zoomAt((a.x+b.x)/2,(a.y+b.y)/2,scale*d/lastDist);
    lastDist=d;
  }
});
function up(e){
  pointers.delete(e.pointerId); lastDist=0; vp.classList.remove('dragging');
  setTimeout(()=>{ if(pointers.size===0) moved=false; },0);
}
vp.addEventListener('pointerup',up); vp.addEventListener('pointercancel',up);
vp.addEventListener('wheel',e=>{ e.preventDefault();
  zoomAt(e.clientX,e.clientY,scale*(e.deltaY<0?1.12:1/1.12)); },{passive:false});

document.getElementById('zin').onclick=()=>zoomAt(vp.clientWidth/2,vp.clientHeight/2,scale*1.3);
document.getElementById('zout').onclick=()=>zoomAt(vp.clientWidth/2,vp.clientHeight/2,scale/1.3);
document.getElementById('zreset').onclick=fit;
window.addEventListener('resize',()=>{clamp();apply();});

/* 地方ナビ */
const nav=document.getElementById('regionNav');
Object.entries(REGIONS).forEach(([name,c])=>{
  const b=document.createElement('button'); b.textContent=name;
  b.onclick=()=>flyTo(c.x,c.y,2.3);
  nav.appendChild(b);
});

/* フィルター */
document.querySelectorAll('.filters [data-f]').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.filters [data-f]').forEach(x=>x.setAttribute('aria-pressed',x===b));
    const f=b.dataset.f;
    pinsEl.querySelectorAll('.pin').forEach(p=>p.classList.toggle('hidden',f!=='all'&&p.dataset.cat!==f));
  };
});
const lbl=document.getElementById('lblToggle');
lbl.onclick=()=>{ labelsOn=!labelsOn; lbl.setAttribute('aria-pressed',labelsOn); apply(); };

/* 詳細シート */
const back=document.getElementById('sheetBack'), sheet=document.getElementById('sheet');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function openSheet(it){
  const k=it.cat==="神様"?'kami':'yokai';
  let img='';
  if(it.image){
    img=`<figure class="illust"><img src="${esc(it.image)}" alt="${esc(it.name)}" loading="lazy">
    <figcaption>出典・参考資料：<a href="${esc(it.srcUrl||'#')}" target="_blank" rel="noopener">${esc(it.srcName||'出典')}</a></figcaption></figure>`;
  }
  sheet.innerHTML=`<button class="x" aria-label="閉じる">×</button>
    <h2>${esc(it.name)}</h2>
    <div><span class="badge ${k}">${esc(it.cat)}</span><span class="badge">${esc(it.region)}</span></div>
    <dl>
      <dt>場所</dt><dd>${esc(it.loc)}</dd>
      <dt>内容</dt><dd>${esc(it.content)}</dd>
      <dt>誕生経緯</dt><dd>${esc(it.origin)}</dd>
    </dl>${img}`;
  back.classList.add('open');
  sheet.querySelector('.x').onclick=closeSheet;
  sheet.scrollTop=0;
}
function openRefs(){
  sheet.innerHTML=`<button class="x" aria-label="閉じる">×</button><h2>参考資料</h2>
    <ul class="refs">${REFERENCES.map(r=>`<li>${esc(r)}</li>`).join('')}</ul>`;
  back.classList.add('open'); sheet.querySelector('.x').onclick=closeSheet;
}
function closeSheet(){ back.classList.remove('open'); }
back.addEventListener('click',e=>{ if(e.target===back) closeSheet(); });
window.addEventListener('keydown',e=>{ if(e.key==='Escape') closeSheet(); });
document.getElementById('refBtn').onclick=openRefs;

fit();
setTimeout(()=>{document.getElementById('hint').style.opacity=0;},4500);
</script>
</body>
